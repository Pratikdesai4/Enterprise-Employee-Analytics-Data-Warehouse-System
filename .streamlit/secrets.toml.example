# Streamlit Community Cloud Secrets Configuration Template
# For local or cloud deployment, rename or populate in Streamlit Cloud Dashboard

[mysql]
host = "127.0.0.1"
port = 3306
user = "root"
password = "your_mysql_password"
oltp_database = "enterprise_hr_oltp"
olap_database = "enterprise_hr_dw"

[app]
backend = "auto" # "mysql" or "auto" (falls back to local analytics warehouse if MySQL is offline)
