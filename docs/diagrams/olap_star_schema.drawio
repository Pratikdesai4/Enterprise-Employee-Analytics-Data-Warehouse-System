        <mxCell id="fact_header" value="Fact_PerformanceReviews" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fillColor=#EF4444;fontColor=#FFFFFF;strokeColor=#DC2626;" vertex="1" parent="1">
          <mxGeometry x="430" y="240" width="310" height="340" as="geometry" />
        </mxCell>
        <mxCell id="fact_c1" value="+ review_fact_id: BIGINT [PK]&#xa;# employee_dim_id: BIGINT [FK - Dim_Employee]&#xa;# department_dim_id: INT [FK - Dim_Department]&#xa;# project_dim_id: INT [FK - Dim_Project]&#xa;# date_dim_id: INT [FK - Dim_Date]&#xa;-- Degenerate Dimensions --&#xa;* review_id: INT&#xa;* employee_id: VARCHAR(20)&#xa;-- Additive &amp; Semi-Additive Measures --&#xa;* performance_rating: INT&#xa;* monthly_income_at_review: DECIMAL(12,2)&#xa;* percent_salary_hike: DECIMAL(5,2)&#xa;* work_life_balance: INT&#xa;* job_satisfaction: INT&#xa;* environment_satisfaction: INT&#xa;* attrition_risk_score: INT&#xa;* tenure_at_review: INT&#xa;* promotion_given: TINYINT(1)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontColor=#0F172A;" vertex="1" parent="fact_header">
          <mxGeometry y="28" width="310" height="302" as="geometry" />
        </mxCell>

