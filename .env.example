# ==============================================================================
# Enterprise Employee Analytics - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed for local or server environments.

# Database Backend Selection ('auto', 'mysql', or 'sqlite')
DB_BACKEND=auto

# MySQL Configuration (Used when DB_BACKEND=mysql or auto-detected)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_OLTP_DB=enterprise_hr_oltp
MYSQL_OLAP_DB=enterprise_hr_dw

# SQLite Warehouse Fallback Path
SQLITE_PATH=data/enterprise_analytics.db

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
